<!DOCTYPE html>
<html>
<head>
<style>
div {
  background-color: lightblue;
  padding: 20px;
  margin: 20px;
  width: 200px;
}

.example1 { border-radius: 10px; }
.example2 { border-radius: 20px; }
.example3 { border-radius: 30px; }
.example4 { border-radius: 50px; }
.example5 { border-radius: 50%; }  /* Makes a circle */
.example6 { border-radius: 10px 50px; } /* top-left/bottom-right | top-right/bottom-left */
.example7 { border-radius: 10px 20px 30px 40px; } /* top-left, top-right, bottom-right, bottom-left */
.example8 { border-top-left-radius: 50px; } /* just one corner */
</style>
</head>
<body>

<h1>CSS Rounded Corners</h1>

<div class="example1">border-radius: 10px</div>
<div class="example2">border-radius: 20px</div>
<div class="example3">border-radius: 30px</div>
<div class="example4">border-radius: 50px</div>
<div class="example5">border-radius: 50% (circle)</div>
<div class="example6">border-radius: 10px 50px</div>
<div class="example7">border-radius: 10px 20px 30px 40px</div>
<div class="example8">border-top-left-radius: 50px</div>

</body>
</html>
